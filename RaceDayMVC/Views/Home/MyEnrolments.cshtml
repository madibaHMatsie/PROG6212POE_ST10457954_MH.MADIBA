@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2 class="mb-4">My Race History</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't enrolled in any events yet.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@item.eventName</h5>
                            <span class="badge bg-light text-dark">Bib: @item.bibNumber</span>
                        </div>
                        <div class="card-body">
                            <p><strong>Category:</strong> @item.categoryName</p>
                            <p><strong>Status:</strong> <span class="badge bg-success">@item.status</span></p>

                            @if (item.result != null)
                            {
                                <div class="alert alert-info mt-3">
                                    <h6 class="alert-heading">Official Result</h6>
                                    <p class="mb-0">Finish Time: @item.result.finishTime</p>
                                    <p class="mb-0">Position: @item.result.finishPosition</p>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mt-3 mb-0">Results will appear here after the race.</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>