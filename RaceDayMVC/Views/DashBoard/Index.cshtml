@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">My Events</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="fw-bold">@ev.name</td>
                            <td>@ev.date.ToString("dd MMM yyyy")</td>
                            <td>@ev.location</td>
                            <td><span class="badge bg-success">@ev.status</span></td>
                            <td class="text-end">
                                <a asp-action="ViewEnrolments" asp-route-id="@ev.eventId" class="btn btn-sm btn-outline-primary">
                                    View Enrolments
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>