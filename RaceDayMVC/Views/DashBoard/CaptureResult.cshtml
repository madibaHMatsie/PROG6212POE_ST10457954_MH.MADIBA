@{
    ViewData["Title"] = "Capture Result";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Capture Result for @ViewBag.ParticipantName</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CaptureResult" method="post">
                        <!-- Hidden fields to pass data back to the controller -->
                        <input type="hidden" name="enrolmentId" value="@ViewBag.EnrolmentId" />
                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Finish Time (HH:mm:ss)</label>
                            <input type="text" name="finishTime" class="form-control" placeholder="e.g. 02:30:45" required pattern="^([0-9]{2}):([0-5][0-9]):([0-5][0-9])$" title="Please use HH:mm:ss format" />
                            <small class="text-muted">Must be in HH:mm:ss format (e.g., 02:15:30)</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Overall Position</label>
                            <input type="number" name="finishPosition" class="form-control" min="1" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Position</label>
                            <input type="number" name="categoryPosition" class="form-control" min="1" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-3">Save Result</button>
                        <a asp-action="ViewEnrolments" asp-route-id="@ViewBag.EventId" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>